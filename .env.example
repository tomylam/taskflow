# ── Backend ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# OpenRouter — LLM analysis
# Get key at: https://openrouter.ai → Sign in → Keys → Create key
OPENROUTER_API_KEY="sk-or-v1-..."

# ── Storj S3-compatible Storage ────────────────────────────────────────────────
# Sign up free at https://storj.io → create a bucket → create S3 credentials
# Free tier: 150 GB storage · 150 GB/month bandwidth · no per-file size limit
#
# Where to find each value in the Storj dashboard:
#   STORJ_ENDPOINT   → Buckets → Access → S3 Credentials → "endpoint"
#   STORJ_ACCESS_KEY → S3 Credentials → "Access Key"
#   STORJ_SECRET_KEY → S3 Credentials → "Secret Key"  (shown only once — copy it!)
#   STORJ_BUCKET     → the bucket name you created (e.g. taskflow)
STORJ_ENDPOINT="https://gateway.storjshare.io"
STORJ_ACCESS_KEY="your-storj-access-key"
STORJ_SECRET_KEY="your-storj-secret-key"
STORJ_BUCKET="taskflow"
# Access Keys → Create Access Grant → Download only → Bucket: taskflow → copy the grant string
STORJ_LINK_ACCESS="your-storj-link-access-grant"

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:4000/api"
