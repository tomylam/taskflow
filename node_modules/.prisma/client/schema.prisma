// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL: sqlite  |  RAILWAY PRODUCTION: switch back to "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums (SQLite: stored as strings) ──────────────────────────────────────

// User role
// DISTRIBUTOR: uploads work, reviews quotes, gives feedback
// PROVIDER: quotes, works on tasks, submits deliverables
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String // "DISTRIBUTOR" | "PROVIDER"
  createdAt    DateTime @default(now())

  tasks    Task[]     @relation("CreatedTasks")
  quotes   Quote[]
  messages Message[]
  files    TaskFile[]
}

// Task status lifecycle
// PENDING_QUOTE → QUOTED → IN_PROGRESS → SUBMITTED → REVISION → COMPLETED
model Task {
  id                String    @id @default(cuid())
  title             String
  status            String    @default("PENDING_QUOTE")
  taskType          String // "ESSAY" | "POWERPOINT" | "SPSS" | "QUESTIONNAIRE" | "LONG_TERM" | "MIXED"
  wordCount         Int?
  deadline          DateTime?
  university        String?
  aiDescription     String? // LLM-generated description
  rawPrompt         String? // original distributor description
  revisionRound     Int       @default(0)
  seenByDistributor Boolean   @default(true) // false = new update not yet seen by distributor
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id])

  files     TaskFile[]
  quotes    Quote[]
  revisions Revision[]
  messages  Message[]
  stages    TaskStage[]
}

// Files attached to a task (stored on Cloudinary)
model TaskFile {
  id          String   @id @default(cuid())
  taskId      String
  driveFileId String
  driveUrl    String
  fileName    String
  mimeType    String
  stageName   String? // null = original upload; set for stage deliverables
  uploadedAt  DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  task         Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Quote submitted by a provider
model Quote {
  id         String   @id @default(cuid())
  taskId     String
  providerId String
  amount     Float
  currency   String   @default("USD")
  note       String?
  status     String   @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED"
  createdAt  DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  provider User @relation(fields: [providerId], references: [id])
}

// Revision request from distributor
model Revision {
  id          String   @id @default(cuid())
  taskId      String
  round       Int
  feedback    String
  requestedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Stage tracking for long-term multi-stage tasks
model TaskStage {
  id      String    @id @default(cuid())
  taskId  String
  name    String // e.g. "Abstract", "Draft", "Full Paper"
  status  String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "SUBMITTED" | "APPROVED"
  dueDate DateTime?
  order   Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// In-task messaging thread between stakeholders
model Message {
  id        String   @id @default(cuid())
  taskId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])
}
